{
  "compilerOptions": {
    "target": "es2022",
    "module": "commonjs",
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": [
    ".",
    "server.ts", 
    "lib/**/*.ts",   
    "types/**/*.ts"  
  ],
  "exclude": ["node_modules"]
}